{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "marketplace.schema.json",
  "title": "Marketplace configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "namespace",
    "publisher",
    "source"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "namespace": {
      "description": "Prefix of every atom reference this repository publishes (`<namespace>/<id>@<version>`).",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "source": {
      "description": "Canonical repository URL.",
      "type": "string"
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "functionalData": {
          "description": "Globs whose non-English lines are functional data (vocabulary, detection patterns, fixtures). Every other line must be American English.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
