{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engine.schema.json",
  "title": "Engine manifest",
  "description": "Runtime files the harness needs next to the market atoms (the atom assembler and its lexicon).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "version",
    "description",
    "tags",
    "files"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/atomId"
    },
    "kind": {
      "const": "engine"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "stability": {
      "$ref": "common.schema.json#/$defs/stability"
    },
    "aliases": {
      "$ref": "common.schema.json#/$defs/aliases"
    },
    "description": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "tags": {
      "$ref": "common.schema.json#/$defs/tags"
    },
    "domains": {
      "$ref": "common.schema.json#/$defs/domains"
    },
    "requires": {
      "$ref": "common.schema.json#/$defs/requires"
    },
    "files": {
      "description": "Repository paths installed into the harness market directory.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
