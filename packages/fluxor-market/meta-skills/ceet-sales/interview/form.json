{
  "$schema": "../../../schemas/form.schema.json",
  "formVersion": "2.0.0",
  "role": "ceet-sales",
  "title": "Sales",
  "nameSlot": "seller_name",
  "intro": "Record consent first (ceet-core references/consent.md). Then ask one question at a time, in order, and dig into vague answers: a recent example, a number, the exception. Record every answer verbatim with `interview.py answer`. The core and the real decisions are required; the depth modules are optional, and `interview.py next` suggests the questions that fill the profile's gaps.",
  "wrap": "Synthesize the profile, then run the teachback: show each directive with the questions it came from and let the person accept, edit or reject it. If they do not recognize themselves, re-interview that section.",
  "routing": {
    "keywords": [
      "sales",
      "discovery call",
      "objection",
      "pipeline",
      "close",
      "qualification",
      "demo",
      "account executive",
      "quota",
      "cold email",
      "negotiation",
      "meddicc",
      "prospecting",
      "deal review"
    ]
  },
  "derived": {
    "identity.contradictions": "Tensions between answers across the whole interview (synthesis rule 5)."
  },
  "profileOnly": {
    "identity.core_values": "Values stay in the profile; task prompts carry the directives they produce (plan item 2.2).",
    "identity.frustration_triggers": "A trait for the person's own reading; the directives that act on it are rendered.",
    "identity.contradictions": "Contradictions stay out of task prompts; the decision framework resolves them (plan item 2.2)."
  },
  "modules": [
    {
      "id": "core",
      "title": "Core interview",
      "optional": false,
      "purpose": "Who the person is and how they reason about selling: enough evidence for the always-on core and the most consequential directives.",
      "sections": [
        {
          "id": "A",
          "title": "Context",
          "questions": [
            {
              "id": "Q1",
              "prompt": "What do you sell, to whom, at what ACV, with what sales cycle?",
              "kind": "open",
              "required": true,
              "minutes": 2,
              "feeds": [
                "identity.cognitive_signature"
              ]
            },
            {
              "id": "Q2",
              "prompt": "What's your motion (inbound, outbound, SLG, PLG hybrid)?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "identity.cognitive_signature"
              ]
            },
            {
              "id": "Q3",
              "prompt": "What's your territory / segment / quota shape?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "identity.cognitive_signature"
              ]
            },
            {
              "id": "Q4",
              "prompt": "Who's in your deal pod (SE / SC, AM, CS, exec sponsor)?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "identity.cognitive_signature",
                "directives.multi_threading.when_bring_exec"
              ]
            }
          ]
        },
        {
          "id": "B",
          "title": "ICP & qualification",
          "questions": [
            {
              "id": "Q5",
              "prompt": "Describe your best-fit buyer — role, company shape, trigger event.",
              "kind": "open",
              "required": true,
              "minutes": 3,
              "probes": [
                "Give me a recent, concrete example."
              ],
              "feeds": [
                "directives.icp_qualification.best_fit"
              ]
            },
            {
              "id": "Q6",
              "prompt": "What's a fast disqualification signal you've learned the hard way?",
              "kind": "open",
              "required": true,
              "minutes": 3,
              "probes": [
                "When does that rule break, and when does it never break?"
              ],
              "feeds": [
                "directives.icp_qualification.fast_disqualify",
                "identity.decision_framework"
              ]
            },
            {
              "id": "Q7",
              "prompt": "How do you tell \"not now\" from \"not ever\"?",
              "kind": "open",
              "required": true,
              "minutes": 2,
              "feeds": [
                "directives.icp_qualification.not_now_vs_not_ever"
              ]
            }
          ]
        },
        {
          "id": "C",
          "title": "Discovery",
          "questions": [
            {
              "id": "Q8",
              "prompt": "What's your opening for a first call — literal words?",
              "kind": "open",
              "required": true,
              "minutes": 2,
              "feeds": [
                "directives.discovery.first_call_opening",
                "identity.communication_voice"
              ]
            },
            {
              "id": "Q9",
              "prompt": "What's your must-ask question that most reps skip?",
              "kind": "open",
              "required": true,
              "minutes": 2,
              "feeds": [
                "directives.discovery.must_ask_questions"
              ]
            },
            {
              "id": "Q10",
              "prompt": "How do you avoid demo-leading when they push for a demo early?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "directives.discovery.avoid_early_demo"
              ]
            },
            {
              "id": "Q11",
              "prompt": "What do you listen for beneath the words — pauses, hedges, pronoun shifts?",
              "kind": "open",
              "required": false,
              "minutes": 3,
              "probes": [
                "Give me a recent, concrete example."
              ],
              "feeds": [
                "directives.discovery.listen_beneath"
              ]
            }
          ]
        },
        {
          "id": "D",
          "title": "Methodology",
          "questions": [
            {
              "id": "Q12",
              "prompt": "MEDDICC / SPICED / Challenger / Sandler — what do you use and how have you customized it?",
              "kind": "open",
              "required": true,
              "minutes": 3,
              "feeds": [
                "directives.methodology.framework_use"
              ]
            },
            {
              "id": "Q13",
              "prompt": "What's a part of your methodology you enforce religiously? A part you ignore?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "probes": [
                "When does that rule break, and when does it never break?"
              ],
              "feeds": [
                "directives.methodology.enforced_vs_ignored"
              ]
            },
            {
              "id": "Q14",
              "prompt": "How do you identify the economic buyer? The blocker?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "directives.methodology.find_econ_buyer"
              ]
            }
          ]
        },
        {
          "id": "E",
          "title": "Objections",
          "questions": [
            {
              "id": "Q15",
              "prompt": "What are the top 5 objections you hear? Walk me through your standard response to each.",
              "kind": "open",
              "required": true,
              "minutes": 4,
              "feeds": [
                "directives.objections.top_five",
                "directives.objections.standard_responses"
              ]
            },
            {
              "id": "Q16",
              "prompt": "What's an objection you used to fear and no longer do? What changed?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "directives.objections.feared_no_longer_fear",
                "directives.meta_cognition.knowledge_evolution"
              ]
            },
            {
              "id": "Q17",
              "prompt": "What's a price objection move you refuse to make?",
              "kind": "open",
              "required": true,
              "minutes": 2,
              "probes": [
                "When does that rule break, and when does it never break?"
              ],
              "feeds": [
                "directives.objections.price_objection",
                "identity.core_values"
              ]
            }
          ]
        },
        {
          "id": "F",
          "title": "Pricing & negotiation",
          "questions": [
            {
              "id": "Q18",
              "prompt": "How do you anchor? When do you introduce price?",
              "kind": "open",
              "required": true,
              "minutes": 2,
              "feeds": [
                "directives.pricing_negotiation.anchor_timing"
              ]
            },
            {
              "id": "Q19",
              "prompt": "Your discount ladder — if you give X, what do you ask in return?",
              "kind": "open",
              "required": true,
              "minutes": 3,
              "probes": [
                "What number would you put on it?"
              ],
              "feeds": [
                "directives.pricing_negotiation.discount_ladder"
              ]
            },
            {
              "id": "Q20",
              "prompt": "What's a trade you always pitch (annual prepay, multi-year, logo rights)?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "directives.pricing_negotiation.trades_pitched"
              ]
            },
            {
              "id": "Q21",
              "prompt": "When do you walk?",
              "kind": "open",
              "required": true,
              "minutes": 2,
              "probes": [
                "When does that rule break, and when does it never break?"
              ],
              "feeds": [
                "directives.pricing_negotiation.walk_criteria",
                "identity.decision_framework"
              ]
            }
          ]
        },
        {
          "id": "I",
          "title": "Forecasting",
          "questions": [
            {
              "id": "Q29",
              "prompt": "What counts as committed in your head vs. in the CRM?",
              "kind": "open",
              "required": true,
              "minutes": 3,
              "feeds": [
                "directives.forecasting.committed_vs_best_case"
              ]
            },
            {
              "id": "Q30",
              "prompt": "How do you tell a rep a deal they love isn't real?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "directives.forecasting.pipeline_hygiene",
                "identity.communication_voice"
              ]
            },
            {
              "id": "Q31",
              "prompt": "What signal screams \"this slips\" to you?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "directives.forecasting.pipeline_hygiene"
              ]
            }
          ]
        },
        {
          "id": "M",
          "title": "Vocabulary & voice",
          "questions": [
            {
              "id": "Q39",
              "prompt": "Your email voice — casual, tight, warm, blunt? Example phrases?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "identity.communication_voice"
              ]
            },
            {
              "id": "Q40",
              "prompt": "Banned phrases (\"Just circling back\", \"Looping you in\")?",
              "kind": "open",
              "required": true,
              "minutes": 2,
              "feeds": [
                "identity.communication_voice"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "decisions",
      "title": "Real decisions",
      "optional": false,
      "purpose": "Cognitive task analysis on the person's own cases: an incident walk-through, a knowledge audit, a simulation on a real artifact, a contrast and a decision with partial information. The answers become the pack's examples.",
      "sections": [
        {
          "id": "O",
          "title": "Real decisions",
          "questions": [
            {
              "id": "Q43",
              "prompt": "Walk me through your last won deal — end to end.",
              "kind": "incident",
              "required": true,
              "minutes": 8,
              "probes": [
                "What did you notice first, and what did it tell you?",
                "What options did you have, and which did you rule out quickly?",
                "What would someone less experienced have done at that point?",
                "What would have changed your mind?"
              ],
              "feeds": [
                "identity.decision_framework",
                "directives.methodology.framework_use",
                "directives.personality.quality_calibration"
              ],
              "captures": [
                "decisions"
              ]
            },
            {
              "id": "Q44",
              "prompt": "Walk me through your last lost deal — honestly.",
              "kind": "incident",
              "required": true,
              "minutes": 6,
              "probes": [
                "What did you notice first, and what did it tell you?",
                "What options did you have, and which did you rule out quickly?",
                "What would someone less experienced have done at that point?",
                "What would have changed your mind?"
              ],
              "feeds": [
                "directives.objections.standard_responses",
                "directives.meta_cognition.knowledge_evolution"
              ],
              "captures": [
                "decisions"
              ]
            },
            {
              "id": "Q45",
              "prompt": "Think of a deal a colleague has marked as commit this quarter. What would a capable, less experienced rep miss in it that you would catch? List the cues you look for.",
              "kind": "knowledge-audit",
              "required": true,
              "minutes": 5,
              "probes": [
                "Why does that cue matter here?",
                "How would you teach someone to see it?"
              ],
              "feeds": [
                "directives.forecasting.committed_vs_best_case",
                "directives.forecasting.pipeline_hygiene",
                "directives.discovery.listen_beneath"
              ],
              "captures": [
                "decisions"
              ]
            },
            {
              "id": "Q46",
              "prompt": "Take a cold email or follow-up you sent this month and rewrite it with me now, for a prospect you are working. Narrate each change as you make it.",
              "kind": "simulation",
              "required": true,
              "minutes": 8,
              "probes": [
                "Why did you cut that?",
                "What would have made you keep it?"
              ],
              "feeds": [
                "directives.outreach.cold_email_length",
                "directives.outreach.subject_line",
                "directives.outreach.cta_style",
                "directives.outreach.follow_up_cadence"
              ],
              "captures": [
                "decisions"
              ]
            },
            {
              "id": "Q47",
              "prompt": "Think of two opportunities that looked alike after the first call, one you pursued hard and one you disqualified (or build the pair now from your pipeline). What exactly made the difference?",
              "kind": "contrastive",
              "required": true,
              "minutes": 4,
              "probes": [
                "Which detail would flip your verdict?"
              ],
              "feeds": [
                "directives.icp_qualification.fast_disqualify",
                "directives.icp_qualification.not_now_vs_not_ever"
              ],
              "captures": [
                "decisions"
              ]
            },
            {
              "id": "Q48",
              "prompt": "Here is all you get: it is the last week of the quarter, your champion went quiet after a verbal yes, procurement asks for 25% off to sign by Friday, and you are 15% short of quota. What do you do, and what is the one extra piece of information you ask for?",
              "kind": "limited-information",
              "required": true,
              "minutes": 4,
              "probes": [
                "Why that piece of information and not another?",
                "When would you walk away without knowing more?"
              ],
              "feeds": [
                "directives.pricing_negotiation.walk_criteria",
                "directives.pricing_negotiation.discount_ladder",
                "directives.multi_threading.dark_champion"
              ],
              "captures": [
                "decisions"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "depth-deals",
      "title": "Depth: champions, outreach and closing",
      "optional": true,
      "purpose": "Multi-threading, the outreach voice, losing deals and the hand-off to customer success.",
      "sections": [
        {
          "id": "G",
          "title": "Multi-threading",
          "questions": [
            {
              "id": "Q22",
              "prompt": "When do you bring in an exec sponsor? When do you refuse to?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "directives.multi_threading.when_bring_exec",
                "directives.multi_threading.refuse_to"
              ]
            },
            {
              "id": "Q23",
              "prompt": "How do you coach a champion who's new to the role?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "directives.multi_threading.coach_champion"
              ]
            },
            {
              "id": "Q24",
              "prompt": "What's your playbook when the champion goes dark?",
              "kind": "open",
              "required": false,
              "minutes": 3,
              "probes": [
                "Give me a recent, concrete example."
              ],
              "feeds": [
                "directives.multi_threading.dark_champion"
              ]
            }
          ]
        },
        {
          "id": "H",
          "title": "Outreach voice",
          "questions": [
            {
              "id": "Q25",
              "prompt": "Cold email — length, subject line style, CTA?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "probes": [
                "What number would you put on it?"
              ],
              "feeds": [
                "directives.outreach.cold_email_length",
                "directives.outreach.subject_line",
                "directives.outreach.cta_style"
              ]
            },
            {
              "id": "Q26",
              "prompt": "Follow-up cadence — how many, how spaced, what changes each time?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "probes": [
                "What number would you put on it?"
              ],
              "feeds": [
                "directives.outreach.follow_up_cadence"
              ]
            },
            {
              "id": "Q27",
              "prompt": "Video / voice memos / LinkedIn — what's in your rotation?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "directives.outreach.follow_up_cadence"
              ]
            },
            {
              "id": "Q28",
              "prompt": "What do you refuse to put in an email (\"Just checking in\", \"Did you see my last…\")?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "identity.communication_voice",
                "directives.outreach.cta_style"
              ]
            }
          ]
        },
        {
          "id": "J",
          "title": "Losing",
          "questions": [
            {
              "id": "Q32",
              "prompt": "When a deal starts slipping, what's your next move — and what's the move you refuse to make?",
              "kind": "open",
              "required": false,
              "minutes": 3,
              "feeds": [
                "identity.decision_framework",
                "identity.core_values"
              ]
            },
            {
              "id": "Q33",
              "prompt": "How do you handle a lost deal — postmortem, re-engage, walk away?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "directives.meta_cognition.knowledge_evolution"
              ]
            }
          ]
        },
        {
          "id": "K",
          "title": "Handoff",
          "questions": [
            {
              "id": "Q34",
              "prompt": "What do you tell CS at handoff — and what do you refuse to promise?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "directives.personality.quality_calibration"
              ]
            },
            {
              "id": "Q35",
              "prompt": "What's your win-wire format?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "identity.communication_voice"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "depth-judgment",
      "title": "Depth: heuristics and anti-patterns",
      "optional": true,
      "purpose": "The person's rules of thumb and what they outgrew.",
      "sections": [
        {
          "id": "L",
          "title": "Heuristics",
          "questions": [
            {
              "id": "Q36",
              "prompt": "\"If they say {X}, they mean {Y}.\"",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "directives.discovery.listen_beneath"
              ]
            },
            {
              "id": "Q37",
              "prompt": "\"When a deal has {X} signal, I {Y}.\"",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "identity.decision_framework"
              ]
            },
            {
              "id": "Q38",
              "prompt": "\"Good discovery ends with {X}.\"",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "directives.discovery.must_ask_questions"
              ]
            }
          ]
        },
        {
          "id": "N",
          "title": "Anti-patterns",
          "questions": [
            {
              "id": "Q41",
              "prompt": "A sales move you outgrew.",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "directives.meta_cognition.knowledge_evolution"
              ]
            },
            {
              "id": "Q42",
              "prompt": "A tactic you see others do that you're embarrassed by.",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "identity.core_values"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "depth-people",
      "title": "Depth: working with others",
      "optional": true,
      "purpose": "Uncertainty, crises, how the person has changed, focus and frustration.",
      "sections": [
        {
          "id": "P",
          "title": "Working with others",
          "questions": [
            {
              "id": "Q49",
              "prompt": "When you are unsure about a call, how do you say so, and at what point do you escalate a decision instead of making it yourself? Give a recent example.",
              "kind": "open",
              "required": false,
              "minutes": 3,
              "feeds": [
                "directives.meta_cognition.uncertainty_voice",
                "directives.meta_cognition.escalation_protocol"
              ]
            },
            {
              "id": "Q50",
              "prompt": "A deal blows up late: the customer finds a promise in the contract you cannot deliver, or a competitor's claim about you spreads through the account. What do you do in the first hour, and how do you talk to people while it is happening?",
              "kind": "open",
              "required": false,
              "minutes": 3,
              "feeds": [
                "directives.meta_cognition.crisis_personality"
              ]
            },
            {
              "id": "Q51",
              "prompt": "What sales belief did you hold firmly three years ago and have dropped since? What changed your mind?",
              "kind": "open",
              "required": false,
              "minutes": 3,
              "feeds": [
                "directives.meta_cognition.knowledge_evolution"
              ]
            },
            {
              "id": "Q52",
              "prompt": "When do you do your best work? Describe a good focus block and what breaks it.",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "directives.personality.focus_preference",
                "directives.personality.flow_state_description"
              ]
            },
            {
              "id": "Q53",
              "prompt": "What reliably frustrates you in a sales team's habits or in how deals get reviewed?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "directives.personality.primary_frustration",
                "identity.frustration_triggers"
              ]
            }
          ]
        }
      ]
    }
  ]
}
