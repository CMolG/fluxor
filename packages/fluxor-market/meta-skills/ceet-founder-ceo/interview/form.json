              ]
            },
            {
              "id": "Q40",
              "prompt": "What's a daily / weekly ritual that's non-negotiable?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "directives.personal_os.calendar_management"
              ]
            },
            {
              "id": "Q41",
              "prompt": "What's a habit you had to kill to be effective?",
              "kind": "open",
              "required": false,
              "minutes": 2,
              "feeds": [
                "directives.meta_cognition.knowledge_evolution"
              ]
            }
          ]
        }
      ]
