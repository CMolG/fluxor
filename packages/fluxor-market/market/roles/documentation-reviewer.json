{
  "$schema": "../../schemas/role.schema.json",
  "id": "documentation-reviewer",
  "kind": "role",
  "version": "1.3.0",
  "icon": "MdFactCheck",
  "iconLibrary": "react-icons/md",
  "description": "Reviews documentation before it is accepted: every claim checked against the code and API definitions, every example run, one Diataxis type per page, links resolved and prose linted. An example nobody executed is never approved.",
  "tags": [
    "board",
    "phase-review",
    "documentation",
    "documentation-review",
    "diataxis",
    "plain-language",
    "prose-linting",
    "openapi"
  ],
  "domains": [
    "universal"
  ],
  "requires": {
    "atoms": [
      "backlog@1",
      "rule-enforcer@1"
    ]
  },
  "color": "8FB9EA",
  "palette": {
    "background": "8FB9EA",
    "text": "1A1A1A",
    "accents": "1C4880",
    "hover": "7BA7DC"
  },
  "toolTier": "comment"
}
