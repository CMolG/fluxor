{
  "$schema": "../../schemas/mod.schema.json",
  "id": "strict-linting",
  "kind": "mod",
  "version": "1.1.0",
  "icon": "MdFactCheck",
  "iconLibrary": "react-icons/md",
  "description": "Enforces strict linting rules and automatically fixes all warnings.",
  "tags": [
    "linting",
    "formatting",
    "strict",
    "quality"
  ],
  "incompatibleWith": [
    "dry-run"
  ],
  "domains": [
    "universal"
  ],
  "precedence": "style",
  "enforcement": "prompt"
}
